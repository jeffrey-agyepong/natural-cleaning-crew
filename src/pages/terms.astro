---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import { brand } from '../config/brand';
import { client } from '../data/client';

const lastUpdated = 'August 25, 2026';
---

<BaseLayout
  title="Terms of Service"
  description={`The terms that govern your use of ${brand.name}'s website and services.`}
>
  <Header slot="header" />

  <Banner title="Terms of Service" />

  <section class="py-section">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <article class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:uppercase prose-a:text-primary-light hover:prose-a:text-primary">
        <p class="text-sm text-text-muted">Last updated: {lastUpdated}</p>

        <p>
          These Terms of Service ("Terms") govern your use of
          <a href={brand.url}>{brand.url.replace('https://', '')}</a> (the "Site")
          and the cleaning services (the "Services") offered by {brand.name}.
          By using the Site or booking Services, you agree to these Terms.
        </p>

        <h2>Using the Site</h2>
        <p>
          You agree to use the Site only for lawful purposes and not to
          submit false or misleading information through our contact form.
          Content on the Site — including text, images, and the {brand.name}
          name and logo — belongs to {brand.name} and may not be copied or
          reused without permission.
        </p>

        <h2>Quotes &amp; Booking</h2>
        <p>
          Quotes requested through the Site are estimates based on the
          information you provide and may be adjusted after an in-person or
          phone assessment. A booking is confirmed once we've agreed on a
          scheduled date, scope of work, and price with you directly.
        </p>

        <h2>Scheduling &amp; Cancellations</h2>
        <p>
          We ask that you reschedule or cancel an appointment at least 24
          hours in advance. Late cancellations or missed appointments may be
          subject to a fee, which we'll disclose to you before it applies.
        </p>

        <h2>Payment</h2>
        <p>
          Payment for Services is due at the time of service unless we've
          agreed to other terms in writing. Pricing is based on the scope of
          work discussed at booking; additional charges may apply for
          services requested beyond that scope.
        </p>

        <h2>Service Guarantee</h2>
        <p>
          If you're not satisfied with a completed cleaning, contact us
          within 24 hours and we'll work with you to make it right, which may
          include a re-clean of the affected areas.
        </p>

        <h2>Limitation of Liability</h2>
        <p>
          To the extent permitted by law, {brand.name} is not liable for
          indirect, incidental, or consequential damages arising from use of
          the Site or the Services. Our liability for any claim related to
          the Services is limited to the amount you paid for the service in
          question.
        </p>
        <p>
          Please secure or disclose fragile, valuable, or irreplaceable items
          before a scheduled cleaning; we're not responsible for damage to
          items that weren't disclosed or reasonably secured.
        </p>

        <h2>Third-Party Links</h2>
        <p>
          The Site may link to third-party sites, such as our Google Business
          Profile or social media pages. We aren't responsible for the
          content or practices of those sites.
        </p>

        <h2>Governing Law</h2>
        <p>
          These Terms are governed by the laws of the State of North
          Carolina, without regard to conflict-of-law principles.
        </p>

        <h2>Changes to These Terms</h2>
        <p>
          We may update these Terms from time to time. Changes take effect
          when posted on this page, with the "Last updated" date revised
          accordingly. Continued use of the Site or Services after changes
          are posted means you accept the updated Terms.
        </p>

        <h2>Contact Us</h2>
        <p>
          Questions about these Terms? Reach us at
          <a href={`mailto:${client.email}`}>{client.email}</a> or
          <a href={`tel:${client.phoneForTel}`}>{client.phoneFormatted}</a>.
        </p>
      </article>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
