---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { reader } from '../lib/keystatic';

const servicesPage = await reader.singletons.servicesPage.read();

const serviceEntries = await reader.collections.services.all();
const services = [...serviceEntries]
  .sort((a, b) => (a.entry.order ?? 0) - (b.entry.order ?? 0))
  .map(({ entry }) => ({
    title: entry.title,
    image: entry.image,
    points: entry.points,
  }));
---

<BaseLayout
  title="Services"
  description={`Explore the full range of services offered by ${brand.name}.`}
>
  <Header slot="header" />

  <Banner title="Our Services" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">

      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          {servicesPage?.heading}
        </h2>

        <p class="mt-3 text-text-muted leading-relaxed">
          {servicesPage?.description}
        </p>
      </div>

      <div class="space-y-8">
      {services.map((service, index) => (
        <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-border bg-background shadow-sm md:grid-cols-2">

          <!-- Image -->
          <div class:list={[
            "h-full",
            index % 2 !== 0 && "md:order-2"
          ]}>
            <img
              src={service.image}
              alt={service.title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center p-8">
            <h3 class="font-heading text-h3 font-semibold text-text">
              {service.title}
            </h3>

            <ul class="mt-5 space-y-3 text-text-muted">
              {service.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      ))}
      </div>



    <div class="rounded-xl border border-border bg-background p-8 shadow-sm mt-8">

      <div class="mb-8">
        <h2 class="font-heading text-h3 font-bold text-text text-center">
          {servicesPage?.uponRequestHeading}
        </h2>

        <p class="mt-2 text-text-muted text-center">
          {servicesPage?.uponRequestDescription}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-x-12 gap-y-4 sm:grid-cols-2">
        {servicesPage?.uponRequestItems.map((item) => (
          <div class="flex items-start gap-3">
            <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
            <span class="text-text-muted">{item}</span>
          </div>
        ))}
      </div>

  </div>

    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>