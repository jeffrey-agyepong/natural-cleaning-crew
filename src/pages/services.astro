---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';

const services = [
  {
    title: 'Dusting',
    image: 'https://ik.imagekit.io/boxhuwbys/dusting-natural-cleaning-crew.jpg',
    points: [
      'Detailed surface and furniture dusting',
      'Eco-friendly cleaning products',
      'Attention to hard-to-reach areas',
      'Perfect for homes and offices',
    ],
  },
  {
    title: 'Disinfecting and Scrubbing',
    image: 'https://ik.imagekit.io/boxhuwbys/scrubbing-natural-cleaning-crew.jpg',
    points: [
      'Deep sanitization of high-touch surfaces',
      'Bathroom and kitchen scrubbing',
      'Safe disinfectants for families and pets',
      'Helps reduce germs and bacteria',
    ],
  },
  {
    title: 'Vacuuming and Mopping',
    image: 'https://ik.imagekit.io/boxhuwbys/vacuuming-natural-cleaning-crew.jpg',
    points: [
      'Hardwood, tile, and carpet cleaning',
      'Streak-free floor mopping',
      'Dust and allergen removal',
      'Professional-grade equipment',
    ],
  },
  {
    title: 'Other Services',
    image: 'https://ik.imagekit.io/boxhuwbys/other-services-natural-cleaning-crew.jpg',
    points: [
      'Move-in and move-out cleaning',
      'Post-construction cleanup',
      'Recurring cleaning plans available',
      'Custom cleaning solutions',
    ],
  },
];
---

<BaseLayout
  title="Services"
  description={`Explore the full range of services offered by ${brand.name}.`}
>
  <Header slot="header" />

  <Banner title="Our Services" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">

      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          What we can do for you
        </h2>

        <p class="mt-3 text-text-muted leading-relaxed">
          Our comprehensive cleaning services are designed with your health and
          the environment in mind. Every product we use is carefully researched
          and approved by the Environmental Working Group.
        </p>
      </div>

      <div class="space-y-8">
      {services.map((service, index) => (
        <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-border bg-background shadow-sm md:grid-cols-2">

          <!-- Image -->
          <div class:list={[
            "h-full",
            index % 2 !== 0 && "md:order-2"
          ]}>
            <img
              src={service.image}
              alt={service.title}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="flex flex-col justify-center p-8">
            <h3 class="font-heading text-h3 font-semibold text-text">
              {service.title}
            </h3>

            <ul class="mt-5 space-y-3 text-text-muted">
              {service.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      ))}
      </div>



    <div class="rounded-xl border border-border bg-background p-8 shadow-sm mt-8">

      <div class="mb-8">
        <h2 class="font-heading text-h3 font-bold text-text text-center">
          Upon Request
        </h2>

        <p class="mt-2 text-text-muted text-center">
          Additional cleaning services available upon request.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-x-12 gap-y-4 sm:grid-cols-2">

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Change bed sheets</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Dust/clean light fixtures</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Polish wood furniture</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Scrub inside oven</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Clean inside refrigerator</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Clean inside cabinets</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Clean inside windows</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Vacuum/sweep deck</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Sweep porch</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Dust ceiling fans</span>
        </div>

        <div class="flex items-start gap-3">
          <span class="mt-2 size-2 shrink-0 rounded-full bg-primary"></span>
          <span class="text-text-muted">Dust blinds</span>
        </div>

      </div>


  </div>

    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>