---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';

const team = [
  { name: 'Rebekah De Beer',   role: 'Manager', image: 'https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-rebekah.jpg' },
  { name: 'Jethro De Beer', role: 'Co-Owner/Primary Cleaner',        image: 'https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-jethro.jpeg' },

];
---

<BaseLayout title="About Us" description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}>
  <Header slot="header" />

  <Banner title="About Us" />

  <!-- Story -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-vacuuming.webp"
          alt="Professional cleaner vacuuming a living room"
          width={700}
          height={500}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-text">Our Story</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">All About Natural Cleaning Crew</h2>
        <p class="text-text-muted leading-relaxed">
          At The Natural Cleaning Crew, we are more than just a cleaning service—we are a family dedicated to creating safe, healthy environments for others. Born out of our own sensitivities to harsh chemicals, we understand the importance of using products that are not only effective but also gentle on those with compromised immune systems and other health concerns. Our mission is to deliver exceptional home and office cleaning services that are safe for everyone, especially those who need it most.
        </p>
        <p class="text-text-muted leading-relaxed">
         We are committed to using environmentally-friendly products that protect both our clients and the planet. By choosing us, you’re not only getting a clean space, but also peace of mind knowing that your home or office is free from harmful chemicals. Our goal is to exceed your expectations by providing a level of care and attention that ensures your environment is as safe as it is spotless.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Our Team</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Meet the crew</h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-2 max-w-3xl mx-auto">
        {team.map(({ name, role, image }) => (
          <div class="overflow-hidden rounded-lg bg-background shadow-sm">
            <Image
              src={image}
              alt={name}
              width={400}
              height={400}
              loading="lazy"
              class="aspect-square w-full object-cover"
            />
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-text">{name}</h3>
              <p class="text-sm text-text-muted">{role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
