---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { Image } from "astro:assets";
import { brand } from "../config/brand";
import { reader } from "../lib/keystatic";

const about = await reader.singletons.about.read();

const teamEntries = await reader.collections.teamMembers.all();
const team = teamEntries.map(({ entry }) => ({
  name: entry.name,
  role: entry.role,
  image: entry.image,
  bio: entry.bio,
}));
---

<BaseLayout
  title="About Us"
  description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}
>
  <Header slot="header" />

  <Banner title="About Us" />

  <section class="pt-section pb-4">
    <div
      class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14"
    >
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-text">
          {about?.introTopper}
        </span>

        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          {about?.introHeading}
        </h2>

        <p class="text-text-muted leading-relaxed">
          {about?.introBody}
        </p>
      </div>

      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-vacuuming.webp"
          alt="Professional cleaner vacuuming a living room"
          width={700}
          height={500}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-section">
    <div
      class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14"
    >
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-spray.webp"
          alt="Professional cleaner spraying a surface with a natural cleaning product"
          width={700}
          height={500}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-text"
          >{about?.storyTopper}</span
        >
        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          {about?.storyHeading}
        </h2>
        {about?.storyBody.map((paragraph) => (
          <p class="text-text-muted leading-relaxed">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="text-topper font-bold uppercase tracking-widest text-text">
        Our Team
      </span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-green-800">
        Meet the crew
      </h2>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {
        team.map(({ name, role, image, bio }) => (
          <div class="overflow-hidden rounded-lg bg-background shadow-sm">
            
            <Image
              src={image}
              alt={name}
              width={400}
              height={400}
              loading="lazy"
              class="aspect-square w-full object-cover"
            />

            <div class="p-5 space-y-3">
              <div>
                <h3 class="font-heading text-lg font-semibold text-text">
                  {name}
                </h3>
                <p class="text-sm text-text-muted">{role}</p>
              </div>

              <p class="text-sm leading-relaxed text-text-muted">
                {bio}
              </p>
            </div>

          </div>
        ))
      }
    </div>
  </div>
</section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
