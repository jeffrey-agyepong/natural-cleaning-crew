---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Banner from "../components/Banner.astro";
import CTA from "../components/CTA.astro";
import { Image } from "astro:assets";
import { brand } from "../config/brand";

const team = [
  {
    name: "Rebekah De Beer",
    role: "Co-Owner/Manager",
    image: "https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-rebekah.jpg",
    bio: `Rebekah has always had a passion for health. When she started cleaning in 2015, she saw the need for a cleaning business that thought carefully about what they are bringing into people's homes and surrounding their bodies with. When she saw the extremely high risk of lung cancer in women who spent many years cleaning, she knew that health had to be one of her top priorities.`,
  },
  {
    name: "Jethro De Beer",
    role: "Co-Owner/Primary Cleaner",
    image: "https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-jethro.jpeg",
    bio: `Jethro is originally from Johannesburg, South Africa, and came to the US in 2017 when he married Rebekah. After cleaning as a side job for a year, he realized how well they worked as a team and made it their full-time business.`,
  },
];
---

<BaseLayout
  title="About Us"
  description={`Learn about ${brand.name} — our story, team, and commitment to quality service.`}
>
  <Header slot="header" />

  <Banner title="About Us" />

  <section class="pt-section pb-4">
    <div
      class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14"
    >
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-text">
          Healthy Living Starts Here
        </span>

        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          A Natural Approach to Home & Office Cleaning
        </h2>

        <p class="text-text-muted leading-relaxed">
          At The Natural Cleaning Crew, we believe that a clean environment is
          essential for a healthy life. Our commitment goes beyond just
          cleaning—we’re dedicated to creating spaces where you can breathe
          easy, knowing that every product we use is safe for you and your loved
          ones. Discover the difference that truly mindful cleaning can make.
        </p>
      </div>

      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-vacuuming.webp"
          alt="Professional cleaner vacuuming a living room"
          width={700}
          height={500}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-section">
    <div
      class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14"
    >
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src="https://ik.imagekit.io/boxhuwbys/natural-cleaning-crew-spray.webp"
          alt="Professional cleaner spraying a surface with a natural cleaning product"
          width={700}
          height={500}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-text"
          >Our Story</span
        >
        <h2 class="font-heading text-h2 font-bold uppercase text-green-800">
          All About Natural Cleaning Crew
        </h2>
        <p class="text-text-muted leading-relaxed">
          At The Natural Cleaning Crew, we are more than just a cleaning
          service—we are a family dedicated to creating safe, healthy
          environments for others. Born out of our own sensitivities to harsh
          chemicals, we understand the importance of using products that are not
          only effective but also gentle on those with compromised immune
          systems and other health concerns. Our mission is to deliver
          exceptional home and office cleaning services that are safe for
          everyone, especially those who need it most.
        </p>
        <p class="text-text-muted leading-relaxed">
          We are committed to using environmentally-friendly products that
          protect both our clients and the planet. By choosing us, you’re not
          only getting a clean space, but also peace of mind knowing that your
          home or office is free from harmful chemicals. Our goal is to exceed
          your expectations by providing a level of care and attention that
          ensures your environment is as safe as it is spotless.
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="text-topper font-bold uppercase tracking-widest text-accent">
        Our Team
      </span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        Meet the crew
      </h2>
    </div>

    <div class="mx-auto grid max-w-4xl grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-2">
      {
        team.map(({ name, role, image, bio }) => (
          <div class="overflow-hidden rounded-lg bg-background shadow-sm">
            
            <Image
              src={image}
              alt={name}
              width={400}
              height={400}
              loading="lazy"
              class="aspect-square w-full object-cover"
            />

            <div class="p-5 space-y-3">
              <div>
                <h3 class="font-heading text-lg font-semibold text-text">
                  {name}
                </h3>
                <p class="text-sm text-text-muted">{role}</p>
              </div>

              <p class="text-sm leading-relaxed text-text-muted">
                {bio}
              </p>
            </div>

          </div>
        ))
      }
    </div>
  </div>
</section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
