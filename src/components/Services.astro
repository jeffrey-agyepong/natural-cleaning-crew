---
interface ServiceItem {
  title: string;
  description: string;
  href?: string;
}

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  services?: ServiceItem[];
  ctaLabel?: string;
  ctaHref?: string;
}

const icons = ['<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19.36 2.72l1.42 1.42l-5.72 5.71c1.07 1.54 1.22 3.39.32 4.59L9.06 8.12c1.2-.9 3.05-.75 4.59.32zM5.93 17.57c-2.01-2.01-3.24-4.41-3.58-6.65l4.88-2.09l7.44 7.44l-2.09 4.88c-2.24-.34-4.64-1.57-6.65-3.58" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12.404 7.23V6.193L10.643 8.03q-.024.025-.272.087q-.165 0-.264-.155q-.1-.155-.013-.303L10.981 6v-.77h-.77q-.261 0-.438-.176q-.177-.177-.177-.439q0-.261.177-.438T10.212 4h4.23q.31 0 .54.23t.23.54v.505q0 .109-.016.185q-.015.077-.065.163l-.804 1.608zm-2 13.77q-.666 0-1.141-.475t-.475-1.14V15.21q0-.212.04-.392q.041-.18.147-.366l3.142-5.896q.14-.27.378-.413q.237-.143.532-.143h.954q.343 0 .575.232t.232.576v10.577q0 .666-.474 1.14T13.173 21z" />',
  '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.23 20.772q-.73-.729-.73-1.77t.729-1.771t1.769-.731t1.771.729t.731 1.769t-.728 1.771t-1.77.731t-1.771-.728m2.828-.713Q5.5 19.617 5.5 19t-.441-1.059Q4.617 17.5 4 17.5t-1.059.441Q2.5 18.383 2.5 19t.441 1.059Q3.383 20.5 4 20.5t1.059-.441M8.836 21.5q-.373 0-.559-.313t-.044-.662q.144-.365.205-.752q.062-.386.062-.773q0-1.868-1.316-3.184T4 14.5q-.14 0-.288.006t-.287.03q-.373.056-.649-.161t-.276-.584v-2.675q0-.667.475-1.141t1.14-.475H5.5V5.6q0-1.716 1.192-2.908T9.599 1.5q1.247 0 2.272.676t1.498 1.816L20.348 20.5H22q.213 0 .356.144t.144.357t-.144.356T22 21.5h-5q-.213 0-.356-.144t-.144-.357t.144-.356T17 20.5h2.27L12.466 4.408q-.377-.86-1.153-1.384T9.6 2.5q-1.282 0-2.19.91q-.91.908-.91 2.19v3.9h1.73q1.459 0 2.48 1.021T11.73 13v6.885q0 .666-.474 1.14t-1.14.475z" />',
];

const {
  topper = 'What We Do',
  heading = 'Our Services',
  description = 'Whether it’s routine upkeep or a deep clean, we bring care, consistency, and quality to every space we clean',
  ctaLabel = 'Learn More About Our Services',
  ctaHref = '/about',
  services = [
    { title: 'Dusting',      description: 'Reliable fixes for plumbing, electrical, drywall, and more — done right the first time.', href: '/services' },
    { title: 'Disinfecting and Scrubbing',        description: 'Professional installation of fixtures, appliances, and systems with clean, code-compliant results.', href: '/services' },
    { title: 'Vacuuming and Mopping',          description: 'Thorough property inspections to catch issues before they become costly problems.', href: '/services' },
  ],
} = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-text">{topper}</span>
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-green-800">{heading}</h2>
      <p class="mt-3 text-text-muted leading-relaxed">{description}</p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {services.map((service, i) => (
        <li>
          <a
            href={service.href || '/services'}
            aria-label={`Learn more about ${service.title}`}
            class="group flex h-full cursor-pointer flex-col rounded-lg border border-border bg-background p-6 shadow-sm transition-shadow duration-200 hover:shadow-md"
          >
            <div class="mb-4 flex size-12 items-center justify-center rounded-lg bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-fg">
              <svg class="size-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[i % icons.length]} />
            </div>
            <h3 class="font-heading text-h3 font-semibold text-text">{service.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-text-muted">{service.description}</p>
          </a>
        </li>
      ))}
    </ul>
          <div class="pt-4 mx-auto flex justify-center">
        <a
          href={ctaHref}
          class="inline-flex min-h-[44px] items-center gap-2 rounded-md bg-lime-700 px-6 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {ctaLabel}
          <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
  </div>
</section>
